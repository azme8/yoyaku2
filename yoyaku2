    function saveBandStyleEdit() {
      const origName = document.getElementById('editBandOriginalName').value;
      const newName = document.getElementById('editBandNameInput').value.trim();
      const newPass = document.getElementById('editBandPassInput').value.trim();
      const textColor = document.getElementById('editBandTextColor').value;
      const bgColor = document.getElementById('editBandBgColor').value;

      if (!newName) { showInfoModal('エラー', 'バンド名を入力してください。', true); return; }
      if (!newPass) { showInfoModal('エラー', 'パスワードを入力してください。', true); return; }

      const duplicate = registeredBands.some(b => b.name === newName && b.name !== origName);
      if (duplicate) {
        showInfoModal('エラー', '同じ名前のバンドがすでに存在します。', true);
        return;
      }

      const target = registeredBands.find(b => b.name === origName);
      if (target) {
        target.name = newName;
        target.pass = newPass;
        target.textColor = textColor;
        target.bgColor = bgColor;
        db.ref('registeredBands').set(registeredBands);

        if (origName !== newName) {
          db.ref(`bandActivityHistory/${origName}`).once('value', snapshot => {
            if (snapshot.exists()) {
              db.ref(`bandActivityHistory/${newName}`).set(snapshot.val());
              db.ref(`bandActivityHistory/${origName}`).remove();
            }
          });

          db.ref(`chats/${origName}`).once('value', snapshot => {
            if (snapshot.exists()) {
              db.ref(`chats/${newName}`).set(snapshot.val());
              db.ref(`chats/${origName}`).remove();
            }
          });

          ['floor4', 'floor3'].forEach(roomKey => {
            ['thisWeek', 'nextWeek'].forEach(weekKey => {
              const weekObj = (allReservations[roomKey] && allReservations[roomKey][weekKey]) || {};
              Object.entries(weekObj).forEach(([slotKey, bookedBand]) => {
                if (bookedBand === origName) {
                  db.ref(`reservations/${roomKey}/${weekKey}/${slotKey}`).set(newName);
                }
              });
            });
          });
        }
      }

      closeBandStyleEditModal();
      renderBandManageList();
      logAction(`バンド「${origName}」→「${newName}」（PW更新）を変更しました`);
      showInfoModal('保存完了', 'バンド名・パスワードを更新しました。');
    }

    let chatDbRef = null;
    function setupChatListener() {
