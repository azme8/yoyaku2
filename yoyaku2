    function exportActivityToCSV() {
      const bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
      let csv = "バンド名,今週予約数,来週予約数,1学期活動数,2学期活動数,3学期活動数,累計活動数\n";
      registeredBands.forEach(bandObj => {
        const name = bandObj.name;
        let twCount = 0;
        let nwCount = 0;
        ['floor4', 'floor3'].forEach(r => {
          Object.values((allReservations[r] || {}).thisWeek || {}).forEach(v => { if (v === name) twCount++; });
          Object.values((allReservations[r] || {}).nextWeek || {}).forEach(v => { if (v === name) nwCount++; });
        });
        const hist = bandActivityHistory[name] || { term1: 0, term2: 0, term3: 0, total: 0 };
        csv += `"${name}",${twCount},${nwCount},${hist.term1 || 0},${hist.term2 || 0},${hist.term3 || 0},${hist.total || 0}\n`;
      });

      const blob = new Blob([bom, csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      const d = new Date();
      a.download = `keion_activity_${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}.csv`;
      a.click();
      URL.revokeObjectURL(url);
      closeExportDataModal();
      logAction('活動実績CSVデータを出力しました');
      showInfoModal('出力完了', 'CSVファイルをダウンロードしました。');
    }

