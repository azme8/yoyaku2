      const currentVal = document.getElementById('currentPassInput').value;
      const newVal = document.getElementById('newPassInput').value.trim();
      const newConfirm = document.getElementById('newPassConfirmInput').value.trim();

      const expectedCurrent = (type === 'admin') ? adminPassword : masterKeyPassword;

      if (currentVal !== expectedCurrent) {
