    function renderActivityView() {
      const tbody = document.getElementById('activityTableBody');
      if (!tbody) return;

      const dateBannerEl = document.getElementById('displayTermDateRange');
      if (dateBannerEl) {
        dateBannerEl.innerText = termDateRanges[currentActivityTerm] || termDateRanges.all;
      }

      let totalThisWeek = 0;
      let totalSelectedTerm = 0;

      const bandStats = registeredBands.map(bandObj => {
        const name = bandObj.name;
        let thisWeekCount = 0;
        let nextWeekCount = 0;

        ['floor4', 'floor3'].forEach(roomKey => {
          const tw = (allReservations[roomKey] || {}).thisWeek || {};
          const nw = (allReservations[roomKey] || {}).nextWeek || {};
          Object.values(tw).forEach(bName => { if (bName === name) thisWeekCount++; });
          Object.values(nw).forEach(bName => { if (bName === name) nextWeekCount++; });
        });

        const hist = bandActivityHistory[name] || { term1: 0, term2: 0, term3: 0, total: 0 };
        
        let displayCount = hist.total || 0;
        if (currentActivityTerm === 'term1') displayCount = hist.term1 || 0;
        if (currentActivityTerm === 'term2') displayCount = hist.term2 || 0;
        if (currentActivityTerm === 'term3') displayCount = hist.term3 || 0;

        totalThisWeek += thisWeekCount;
        totalSelectedTerm += displayCount;

        return { name, textColor: bandObj.textColor || '#0f172a', bgColor: bandObj.bgColor || '#ffffff', thisWeekCount, nextWeekCount, displayCount, total: hist.total || 0 };
      });

      bandStats.sort((a, b) => b.displayCount - a.displayCount || b.thisWeekCount - a.thisWeekCount);

      document.getElementById('statTotalBands').innerText = `${registeredBands.length}`;
      document.getElementById('statThisWeekTotal').innerText = `${totalThisWeek}`;
      document.getElementById('statAllTimeTotal').innerText = `${totalSelectedTerm}`;

      const maxCount = Math.max(...bandStats.map(s => s.displayCount), 1);
      tbody.innerHTML = '';

      if (bandStats.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="color: var(--text-muted); padding: 12px;">登録バンドがありません。</td></tr>';
        return;
      }

      bandStats.forEach((stat, idx) => {
        const tr = document.createElement('tr');
        tr.style.backgroundColor = stat.bgColor;
        const percent = Math.round((stat.displayCount / maxCount) * 100);
        let badgeHtml = '<span class="badge-low">少なめ</span>';
        if (stat.thisWeekCount >= 2 || stat.displayCount >= 5) badgeHtml = '<span class="badge-active">活発</span>';
        else if (stat.thisWeekCount >= 1 || stat.displayCount >= 2) badgeHtml = '<span class="badge-normal">標準</span>';

        const rankPrefix = idx === 0 && stat.displayCount > 0 ? '[1位] ' : '';

        tr.innerHTML = `
          <td style="text-align: left; padding-left: 6px; color: ${stat.textColor};">
            <b>${rankPrefix}${stat.name}</b>
            <button class="activity-admin-btn" onclick="openBandStyleEditModal('${stat.name}')">編集</button>
          </td>
          <td style="color: ${stat.textColor};"><b>${stat.thisWeekCount}</b></td>
          <td style="color: ${stat.textColor};"><b>${stat.nextWeekCount}</b></td>
          <td style="color: ${stat.textColor};">
            <b>${stat.displayCount}</b>
            <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: ${percent}%;"></div></div>
          </td>
          <td>${badgeHtml}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openActivityManageModal() {
      document.getElementById('modalTermSelect').value = currentActivityTerm;
      renderActivityManageList();
      document.getElementById('activityManageModal').style.display = 'flex';
    }
    function closeActivityManageModal() { document.getElementById('activityManageModal').style.display = 'none'; }

    function changeActiveTermSetting(val) {
      currentActivityTerm = val;
      document.getElementById('selectActiveTerm').value = val;
      renderActivityView();
      renderActivityManageList();
    }

    function renderActivityManageList() {
      const container = document.getElementById('activityManageListContainer');
      container.innerHTML = '';
      registeredBands.forEach(band => {
        const hist = bandActivityHistory[band.name] || { term1: 0, term2: 0, term3: 0, total: 0 };
        const termKey = currentActivityTerm === 'all' ? 'total' : currentActivityTerm;
        const currentCount = hist[termKey] || 0;

        const div = document.createElement('div');
        div.className = 'list-item';
        div.innerHTML = `
          <span><b>${band.name}</b> : ${currentActivityTerm === 'all' ? '累計' : currentActivityTerm} <b>${currentCount}</b> 回</span>
          <div style="display: flex; gap: 4px;">
            <button class="btn" style="background: var(--success); color: white; padding: 2px 6px; font-size: 10px;" onclick="adjustTermActivityCount('${band.name}', 1)">+1</button>
            <button class="btn" style="background: var(--danger); color: white; padding: 2px 6px; font-size: 10px;" onclick="adjustTermActivityCount('${band.name}', -1)">-1</button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function adjustTermActivityCount(bandName, delta) {
      const hist = bandActivityHistory[bandName] || { term1: 0, term2: 0, term3: 0, total: 0 };
      const termKey = currentActivityTerm === 'all' ? 'total' : currentActivityTerm;
      hist[termKey] = Math.max(0, (hist[termKey] || 0) + delta);
      if (currentActivityTerm !== 'all') {
        let sum = (hist.term1 || 0) + (hist.term2 || 0) + (hist.term3 || 0);
        hist.total = sum;
      }
      bandActivityHistory[bandName] = hist;
      db.ref(`bandActivityHistory/${bandName}`).set(hist);
      renderActivityManageList();
      renderActivityView();
      logAction(`バンド「${bandName}」の活動数を調整しました`);
    }

    function confirmResetCurrentTermActivityCounts() {
      showCustomConfirm('活動数のリセット', `選択中の期間の回数をすべて0にリセットしますか？`, () => {
        registeredBands.forEach(band => {
          const hist = bandActivityHistory[band.name] || { term1: 0, term2: 0, term3: 0, total: 0 };
          if (currentActivityTerm === 'all') {
            hist.term1 = 0; hist.term2 = 0; hist.term3 = 0; hist.total = 0;
          } else {
            hist[currentActivityTerm] = 0;
            hist.total = (hist.term1 || 0) + (hist.term2 || 0) + (hist.term3 || 0);
          }
          db.ref(`bandActivityHistory/${band.name}`).set(hist);
        });
        renderActivityManageList();
        renderActivityView();
        logAction('活動数をリセットしました');
        showInfoModal('完了', 'リセットしました。');
      }, 'リセット', 'var(--danger)');
    }
  </script>
</body>
</html>
