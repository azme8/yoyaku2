    function renderTable() {
      const tbody = document.getElementById('timetableBody');
      tbody.innerHTML = '';
      const slots = floorTimes[currentRoom] || defaultFloorTimesStruct[currentRoom];

      slots.forEach((item, idx) => {
        const slotLabel = item.slotLabel || `コマ${idx + 1}`;
        const slotKeyId = `コマ${idx + 1}`;
        const tr = document.createElement('tr');
        const tdTime = document.createElement('td');
        tdTime.className = 'time-col';
        tdTime.innerHTML = `<span>${slotLabel}</span><br>${item.nameA || 'A'}:${item.a}<br>${item.nameB || 'B'}:${item.b}<br>${item.nameAM || 'AM'}:${item.am}<br>${item.nameLong || '長期'}:${item.long}` +
          `<button class="row-delete-btn" onclick="confirmDeleteTimeSlotRow(${idx}, event)">削除</button>`;
        tdTime.onclick = () => { if (isAdmin || isMasterKeyLogin) openTimeModal(idx); };
        tr.appendChild(tdTime);

        days.forEach(day => {
          const td = document.createElement('td');
          td.className = 'slot';
          const key = `${day}_${slotKeyId}`;
          const bookedName = ((allReservations[currentRoom] || {})[currentWeek] || {})[key] || '';
          if (bookedName) {
            const isRegistered = registeredBands.some(b => b.name === bookedName);
            if (!isRegistered || bookedName.includes("管理者") || bookedName === "管理者") {
              td.classList.add('booked-admin');
            } else {
              td.classList.add('booked');
            }
            td.innerText = bookedName;
          } else {
            td.classList.add('free');
            td.innerText = '-';
          }
          td.onclick = () => handleSlotClick(key, bookedName, idx);
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
    }

    function handleSlotClick(key, currentName, slotIdx) {
      if (currentName) return; 
      if (!currentLoginBand) { showInfoModal('予約エラー', 'ログインしてください。', true); return; }
      targetBookingKey = key;
      
      const parts = key.split('_');
      const dayCode = parts[0];
      const dayFullStr = dayNames[dayCode] ? dayNames[dayCode] + '曜日' : dayCode;
      
      const slots = floorTimes[currentRoom] || defaultFloorTimesStruct[currentRoom];
      const slotObj = slots[slotIdx] || { slotLabel: `コマ${slotIdx+1}`, a: '' };
      
      const roomDisplayName = roomNames[currentRoom] || '部室';
      const detailString = `${roomDisplayName} / ${dayFullStr} / ${slotObj.slotLabel} (${slotObj.a || slotObj.b || ''})`;
      
      document.getElementById('bookingDetailText').innerText = detailString;
      document.getElementById('bookingModalTitle').innerText = `📅 予約の確認`;
      
      const adminArea = document.getElementById('adminBookingNameArea');
      if (isAdmin || isMasterKeyLogin) {
        adminArea.style.display = 'block';
        document.getElementById('inputAdminBookingName').value = currentLoginBand;
        document.getElementById('bookingConfirmText').innerHTML = `予約名を確認・入力してください：`;
      } else {
        adminArea.style.display = 'none';
        document.getElementById('bookingConfirmText').innerHTML = `「<b>${currentLoginBand}</b>」としてこの枠を予約しますか？`;
      }
      document.getElementById('bookingModal').style.display = 'flex';
    }

    function closeBookingModal() { document.getElementById('bookingModal').style.display = 'none'; }

    function executeBooking() {
      if (!targetBookingKey || !currentLoginBand) return;
      let bookingName = currentLoginBand;
      if (isAdmin || isMasterKeyLogin) {
        const customName = document.getElementById('inputAdminBookingName').value.trim();
        if (customName) bookingName = customName;
      }

      if (!isAdmin && !isMasterKeyLogin) {
        let floor4Count = 0;
        let floor3Count = 0;
        const tw4 = (allReservations['floor4'] || {})[currentWeek] || {};
        const tw3 = (allReservations['floor3'] || {})[currentWeek] || {};

        Object.values(tw4).forEach(name => { if (name === bookingName) floor4Count++; });
        Object.values(tw3).forEach(name => { if (name === bookingName) floor3Count++; });

        const totalCount = floor4Count + floor3Count;

        const now = new Date();
        const dayOfWeek = now.getDay();
        const isAfterWednesday = (dayOfWeek >= 3 || dayOfWeek === 0);

        if (totalCount >= 1) {
          if (!isAfterWednesday) {
            closeBookingModal();
            showInfoModal('予約制限', '月曜・火曜日は4階・3階あわせて1コマまでしか予約できません。', true);
            return;
          } else {
            if (totalCount >= 2) {
              closeBookingModal();
              showInfoModal('予約制限', '今週の予約上限（最大2コマ）に達しています。', true);
              return;
            }
            if (currentRoom !== 'floor3') {
              closeBookingModal();
              showInfoModal('予約制限', '水曜日以降に追加で予約できるのは「3階部室」のみです。', true);
              return;
            }
          }
        }
      }

      db.ref(`reservations/${currentRoom}/${currentWeek}/${targetBookingKey}`).set(bookingName);
      
      if (registeredBands.some(b => b.name === bookingName)) {
        const hist = bandActivityHistory[bookingName] || { term1: 0, term2: 0, term3: 0, total: 0 };
        const nowTerm = currentActivityTerm === 'all' ? 'term1' : currentActivityTerm;
        hist[nowTerm] = (hist[nowTerm] || 0) + 1;
        hist.total = (hist.total || 0) + 1;
        db.ref(`bandActivityHistory/${bookingName}`).set(hist);
      }

      closeBookingModal();
      logAction(`${bookingName} が予約しました`);
      showInfoModal('予約完了', '予約が完了しました。');
    }

